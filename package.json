{
  "name": "in-browser-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/telemetry/tsconfig.json --noEmit",
    "test": "npm run build && node packages/telemetry/test-utils/run-tests.mjs unit",
    "test:integration": "npm run build && node packages/telemetry/test-utils/run-tests.mjs integration",
    "test:e2e": "npm run build && playwright test -c packages/telemetry/playwright.config.ts",
    "test:e2e:real-prompt-api": "npm run build && playwright test -c packages/telemetry/playwright.real-prompt-api.config.ts",
    "test:e2e:real-prompt-api-streaming": "npm run build && playwright test -c packages/telemetry/playwright.real-prompt-api-streaming.config.ts",
    "examples": "node examples/shared/server.mjs",
    "build": "tsc -p packages/telemetry/tsconfig.json",
    "verify:examples": "node packages/telemetry/test-utils/verify-examples.mjs",
    "measure:overhead": "npm run build && node packages/telemetry/test-utils/measure-overhead.mjs",
    "verify": "npm run typecheck && npm test && npm run test:integration && npm run test:e2e && npm run build && npm run verify:examples"
  },
  "devDependencies": {
    "@playwright/test": "^1.34.3",
    "typescript": "4.9.5"
  }
}
